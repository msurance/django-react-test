{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(npm test:*)",
      "Bash(npx:*)",
      "Bash(ruff:*)",
      "Bash(pip:*)",
      "Bash(python -m pytest:*)"
    ],
    "deny": [
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Bash(rm -rf:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json,subprocess as sp;d=json.load(sys.stdin);f=d.get('tool_input',{}).get('file_path','');f and f.endswith('.py') and sp.run(['ruff','check','--fix',f],capture_output=True)\" 2>/dev/null || true",
            "statusMessage": "Linting Python..."
          }
        ]
      }
    ]
  }
}